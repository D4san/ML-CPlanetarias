---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { courseConfig } from '../../config/course.config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = courseConfig.identity.title,
  description = courseConfig.identity.description ??
    'Curso interactivo y reproducible de machine learning para ciencias planetarias.',
  noindex = false,
} = Astro.props;
const fullTitle =
  title === courseConfig.identity.title ? title : `${title} · ${courseConfig.identity.title}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071a25" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
