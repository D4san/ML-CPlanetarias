---
import ProvenanceNote from '../components/ProvenanceNote.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
  summary: string;
  kind: string;
  status: string;
  source_vault?: string;
  source_note?: string;
  source_path?: string;
  source_heading: string;
  rights: { note: string };
}

const {
  title,
  summary,
  kind,
  status,
  source_vault,
  source_note,
  source_path,
  source_heading,
  rights,
} = Astro.props;
const provenanceLabel = source_vault ?? 'Repositorio';
const provenancePath = source_note ?? source_path ?? 'ruta no indicada';
---

<SiteLayout title={title} description={summary}>
  <header class="site-shell page-intro">
    <span class="eyebrow">{kind} · {status}</span>
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
  </header>
  <article class="article-body">
    <slot />
    <ProvenanceNote
      note={provenancePath}
      heading={source_heading}
      vault={provenanceLabel}
      rights={rights.note}
    />
  </article>
</SiteLayout>
