---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import { courseConfig } from '../../../config/course.config';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getConceptBacklinks } from '../../lib/concept-links';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const [concepts, sessions, exercises] = await Promise.all([
    getCollection('concepts'),
    getCollection('sessions'),
    getCollection('exercises'),
  ]);
  return concepts.map((entry) => {
    const backlinks = getConceptBacklinks(entry.id, sessions, exercises, courseConfig);
    return {
      params: { id: entry.id },
      props: { entry, ...backlinks },
    };
  });
}

interface Props {
  entry: CollectionEntry<'concepts'>;
  sessions: CollectionEntry<'sessions'>[];
  exercises: CollectionEntry<'exercises'>[];
}

const { entry, sessions, exercises } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout {...entry.data}>
  <Content />
  <section aria-labelledby="used-by-title">
    <h2 id="used-by-title">Dónde se usa</h2>
    {
      sessions.length + exercises.length === 0 ? (
        <p>Aún no hay sesiones o ejercicios públicos enlazados.</p>
      ) : (
        <ul>
          {sessions.map((session) => (
            <li>
              <a href={withBase(`/sesiones/${session.id}/`)}>{session.data.title}</a>
            </li>
          ))}
          {exercises.map((exercise) => (
            <li>
              <a href={withBase(`/ejercicios/${exercise.id}/`)}>{exercise.data.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</ArticleLayout>
