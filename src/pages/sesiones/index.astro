---
import { getCollection } from 'astro:content';

import SiteLayout from '../../layouts/SiteLayout.astro';
import { courseConfig } from '../../../config/course.config';
import { isSessionAvailable } from '../../lib/course-availability';
import { withBase } from '../../lib/urls';

const sessions = (await getCollection('sessions'))
  .filter((session) => isSessionAvailable(courseConfig, session.data.session))
  .sort((a, b) => a.data.order - b.data.order);
const showS00 = isSessionAvailable(courseConfig, 'S00');
const showS01 = isSessionAvailable(courseConfig, 'S01');
const showInternalSessions = showS00 || showS01;
---

<SiteLayout
  title="Sesiones"
  description="Sesiones y prototipos del curso ML Ciencias Planetarias con estado explícito."
>
  <header class="site-shell page-intro">
    <span class="eyebrow">Cadencia quincenal</span>
    <h1>Sesiones</h1>
    <p class="lede">
      Cada sesión conecta pregunta científica, teoría formal, evaluación, límites y transferencia
      docente. Los prototipos internos y el contenido revisado muestran siempre su estado.
    </p>
  </header>
  <section class="site-shell" aria-label="Listado de sesiones">
    <ol class="collection-list">
      {
        showS00 && (
          <li class="session-preview session-preview--s00">
            <span class="eyebrow">S00 · introducción</span>
            <div>
              <span class="status-tag">Orientación interna</span>
              <h2>
                <a href={withBase('/sesiones/s00/')}>Leer el curso, configurar el fork</a>
              </h2>
              <p>
                Una entrada guiada a la cadena científica, las vistas del curso y la procedencia de
                una adaptación reproducible.
              </p>
              <a class="text-link" href={withBase('/sesiones/s00/')}>
                Explorar la sesión 0
              </a>
            </div>
          </li>
        )
      }
      {
        showS01 && (
          <li class="session-preview">
            <span class="eyebrow">S01 · en desarrollo</span>
            <div>
              <span class="status-tag">Prototipo interno</span>
              <h2>
                <a href={withBase('/sistema/')}>ML, IA y métodos estadísticos</a>
              </h2>
              <p>
                Construye el recorrido desde la pregunta científica hasta los datos, la señal, la
                tarea, la familia de modelo, la evaluación y sus límites.
              </p>
              <a class="text-link" href={withBase('/sistema/')}>
                Explorar la sesión 1
              </a>
            </div>
          </li>
        )
      }
      {
        sessions.map((session) => (
          <li>
            <span class="eyebrow">{session.data.session}</span>
            <div>
              <h2>
                <a href={withBase(`/sesiones/${session.id}/`)}>{session.data.title}</a>
              </h2>
              <p>{session.data.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
    {
      sessions.length === 0 && (
        <p class="sessions-public-note">
          {showInternalSessions
            ? `Las colecciones públicas siguen vacías. ${showS00 && showS01 ? 'S00 y S01' : showS00 ? 'S00' : 'S01'} se listan aquí como prototipos internos mientras continúa la revisión editorial.`
            : 'Las colecciones públicas siguen vacías y todavía no hay sesiones habilitadas para mostrar.'}
        </p>
      )
    }
  </section>
</SiteLayout>

<style>
  .session-preview {
    border-top: 0.2rem solid var(--data);
  }

  .session-preview .status-tag {
    margin-bottom: var(--space-4);
  }

  .session-preview h2 {
    font-size: var(--step-3);
  }

  .session-preview p {
    max-width: 58ch;
    margin-bottom: var(--space-4);
  }

  .sessions-public-note {
    max-width: 64ch;
    margin-top: var(--space-5);
    color: var(--ink-700);
    font-size: var(--step--1);
  }
</style>
