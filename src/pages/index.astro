---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/urls';
---

<SiteLayout
  title="ML Ciencias Planetarias"
  description="Curso de machine learning para formular, evaluar y enseñar problemas de ciencias planetarias."
>
  <section class="home-intro site-shell">
    <div class="home-intro__copy">
      <p class="eyebrow">Curso de machine learning en ciencias planetarias</p>
      <h1>Comprender el problema antes de elegir el modelo.</h1>
      <p class="lede">
        ML Ciencias Planetarias conecta preguntas astronómicas, teoría formal de machine learning y
        aplicaciones reproducibles para aprender a modelar con rigor y volver a explicarlo.
      </p>
      <p>
        El curso acompaña el paso desde una observación y una pregunta científica hasta una salida
        que pueda interpretarse, evaluarse y enseñarse con sus límites explícitos.
      </p>
    </div>

    <div class="home-intro__aside">
      <section class="home-scope" aria-labelledby="home-scope-title">
        <p class="eyebrow">Alcance del curso</p>
        <h2 id="home-scope-title">Tres líneas que avanzan juntas.</h2>
        <ol>
          <li>
            <span>01</span>
            <div>
              <h3>Problemas astronómicos</h3>
              <p>
                Observables, preguntas científicas, sesgos de adquisición y utilidad de la salida.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Teoría formal ML</h3>
              <p>Representación, tarea, familia de modelo, generalización y evaluación.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Aplicaciones y transferencia</h3>
              <p>Experimentos reproducibles, interpretación y recursos para otros tutores.</p>
            </div>
          </li>
        </ol>
      </section>

      <nav class="home-destinations" aria-label="Destinos principales del curso">
        <a class="home-destination home-destination--primary" href={withBase('/sesiones/')}>
          <span class="home-destination__number">01</span>
          <span>
            <strong>Sesiones</strong>
            <span>Recorre el desarrollo del curso y sus preguntas de trabajo.</span>
            <span class="text-link">Ver sesiones</span>
          </span>
        </a>
        <a class="home-destination" href={withBase('/glosario/')}>
          <span class="home-destination__number">02</span>
          <span>
            <strong>Glosario</strong>
            <span>Consulta los conceptos y sus relaciones dentro del curso.</span>
            <span class="text-link">Abrir glosario</span>
          </span>
        </a>
      </nav>
    </div>
  </section>
</SiteLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: end;
    padding-block: clamp(5rem, 12vw, 8rem) var(--space-8);
  }

  .home-intro__copy {
    max-width: 58ch;
  }

  .home-intro h1 {
    max-width: 12ch;
    margin-bottom: var(--space-5);
  }

  .home-intro__copy > p:last-child {
    max-width: 48ch;
    color: var(--ink-700);
  }

  .home-intro__aside {
    display: grid;
    gap: var(--space-7);
    align-content: end;
  }

  .home-scope {
    padding-top: var(--space-5);
    border-top: 0.2rem solid var(--data);
  }

  .home-scope h2 {
    max-width: 14ch;
    margin-bottom: var(--space-5);
  }

  .home-scope ol {
    margin: 0;
    padding: 0;
    border-top: var(--line);
    list-style: none;
  }

  .home-scope li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--line);
  }

  .home-scope li > span {
    color: var(--data);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .home-scope h3 {
    margin-bottom: var(--space-1);
    font-size: var(--step-1);
  }

  .home-scope p {
    margin: 0;
    color: var(--ink-700);
    font-size: var(--step--1);
  }

  .home-destinations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .home-destination {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    min-height: 11rem;
    padding: var(--space-5);
    border: 1px solid var(--paper-300);
    color: var(--ink-950);
    background: rgb(255 253 248 / 0.58);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .home-destination:hover {
    border-color: var(--data);
    color: var(--ink-950);
    background: var(--white);
    transform: translateY(-0.2rem);
  }

  .home-destination--primary {
    border-color: var(--data);
  }

  .home-destination__number {
    color: var(--data);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .home-destination strong,
  .home-destination > span:last-child > span:first-of-type {
    display: block;
  }

  .home-destination strong {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .home-destination > span:last-child > span:first-of-type {
    margin-bottom: var(--space-4);
    color: var(--ink-700);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .home-destination .text-link {
    color: var(--data);
    font-size: var(--step--1);
    font-weight: 700;
  }

  @media (max-width: 60rem) {
    .home-intro {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--space-8);
    }

    .home-intro__copy {
      max-width: 60ch;
    }

    .home-intro__aside {
      max-width: 64rem;
    }
  }

  @media (max-width: 38rem) {
    .home-intro {
      padding-block: var(--space-8) var(--space-7);
    }

    .home-destinations {
      grid-template-columns: 1fr;
    }

    .home-destination {
      min-height: auto;
    }
  }
</style>
