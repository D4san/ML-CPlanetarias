---
import SessionBookFallback from './SessionBookFallback.astro';
import S02LearningJourney from './react/S02LearningJourney';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Sesión 02 · Árboles de decisión y Random Forest"
  description="Presentación interna e interactiva sobre árboles, bootstrap y Random Forest, con una práctica de regresión planetaria en Colab."
  noindex
  theme="dark"
  fullBleed
>
  <div class="s02-session-shell">
    <section class="site-shell s02-instrument" aria-label="Presentación de la sesión 02">
      <S02LearningJourney client:load />
    </section>

    <noscript><SessionBookFallback session="S02" /></noscript>
  </div>
</SiteLayout>

<style>
  .s02-session-shell {
    position: fixed;
    z-index: 30;
    inset: 0;
    display: grid;
    overflow: hidden;
    place-items: center;
    background: var(--ink-950);
  }

  .s02-instrument {
    width: min(100vw, 177.7778svh);
    height: min(100svh, 56.25vw);
    aspect-ratio: 16 / 9;
    padding: 0;
  }

  .s02-fallback {
    position: fixed;
    z-index: 50;
    inset: 0;
    overflow-y: auto;
    padding: var(--space-8);
    color: var(--paper-100);
    background: var(--ink-950);
  }

  .s02-fallback h2 {
    max-width: 16ch;
  }

  .s02-fallback h3 {
    margin-top: var(--space-7);
    font-size: var(--step-1);
  }

  .s02-fallback h4 {
    margin-block: var(--space-4) var(--space-1);
  }

  .s02-fallback-table-wrap {
    overflow-x: auto;
  }

  .s02-fallback table {
    width: min(100%, 36rem);
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    text-align: left;
  }

  .s02-fallback caption {
    padding-block: var(--space-3);
    text-align: left;
  }

  .s02-fallback :is(th, td) {
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }

  .s02-fallback ol {
    padding-left: 1.3rem;
  }

  .s02-fallback li {
    padding-left: var(--space-2);
  }

  .s02-fallback p {
    max-width: 72ch;
  }

  :global(body:has(.s02-session-shell)) {
    overflow: hidden;
    background: var(--ink-950);
  }

  :global(body:has(.s02-session-shell) .site-header),
  :global(body:has(.s02-session-shell) .site-footer) {
    display: none;
  }

  :global(body:has(.s02-session-shell) #contenido) {
    margin: 0;
  }

  @media (min-width: 49rem) and (max-aspect-ratio: 16 / 9) {
    .s02-instrument {
      width: 100vw;
      height: 100svh;
      aspect-ratio: auto;
    }
  }

  @media (max-width: 48rem) {
    .s02-session-shell {
      position: relative;
      display: block;
      overflow: visible;
    }

    .s02-instrument {
      width: 100%;
      height: auto;
      aspect-ratio: auto;
      padding-block: var(--space-3);
    }

    :global(body:has(.s02-session-shell)) {
      overflow: auto;
    }

    :global(body:has(.s02-session-shell) .site-header),
    :global(body:has(.s02-session-shell) .site-footer) {
      display: block;
    }
  }
</style>
