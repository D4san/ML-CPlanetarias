---
import { withBase } from '../lib/urls';
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div>
      <p class="footer-title">ML Ciencias Planetarias</p>
      <p>Material reproducible para comprender, aplicar y volver a enseñar.</p>
    </div>
    <div>
      <span class="status-tag">S01 en revisión</span>
      <p><a href={withBase('/sistema/')}>Abrir la sesión 1</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    padding-block: var(--space-7);
    border-top: var(--line);
    color: var(--paper-100);
    background: var(--ink-950);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-7);
  }

  .footer-grid > div:last-child {
    justify-self: end;
  }

  .footer-title {
    margin-bottom: var(--space-2);
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  p {
    max-width: 42ch;
    margin-bottom: var(--space-3);
    color: var(--paper-300);
  }

  a {
    color: var(--data-soft);
  }

  .status-tag {
    color: var(--paper-100);
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.18);
  }

  @media (max-width: 42rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .footer-grid > div:last-child {
      justify-self: start;
    }
  }
</style>
