---
import { withBase } from '../lib/urls';
import { courseConfig } from '../../config/course.config';
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div>
      <p class="footer-title">{courseConfig.identity.title}</p>
      <p>Material reproducible para comprender, aplicar y volver a enseñar.</p>
    </div>
    <div>
      <a href={withBase('/sesiones/')}>Sesiones</a>
      <a href={withBase('/glosario/')}>Glosario</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    padding-block: var(--space-7);
    border-top: var(--line);
    color: var(--paper-100);
    background: var(--ink-950);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-7);
  }

  .footer-grid > div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-self: end;
  }

  .footer-title {
    margin-bottom: var(--space-2);
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  p {
    max-width: 42ch;
    margin-bottom: var(--space-3);
    color: var(--paper-300);
  }

  a {
    color: var(--data-soft);
  }

  @media (max-width: 42rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .footer-grid > div:last-child {
      justify-self: start;
    }
  }
</style>
