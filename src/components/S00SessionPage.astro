---
import SessionBookFallback from './SessionBookFallback.astro';
import S00LearningJourney from './react/S00LearningJourney';
import SiteLayout from '../layouts/SiteLayout.astro';
import type { CourseConfig } from '../lib/course-config';

interface Props {
  config: CourseConfig;
}

const { config } = Astro.props;
---

<SiteLayout
  title="Sesión 0 · De los mundos a los datos"
  description="Introducción interna al aprendizaje automático para exoplanetas: de la pregunta científica a la evidencia condicionada."
  noindex
  theme="dark"
  fullBleed
>
  <div class="s00-session-shell">
    <section class="site-shell s00-instrument" aria-label="Recorrido de la sesión 0">
      <S00LearningJourney config={config} client:load />
    </section>

    <noscript><SessionBookFallback session="S00" /></noscript>
  </div>
</SiteLayout>

<style>
  .s00-session-shell {
    overflow: clip;
    padding-top: clamp(1rem, 3vw, 2.5rem);
  }

  .s00-instrument {
    padding-block: 0 var(--space-7);
  }

  .s00-fallback {
    padding-block: var(--space-8);
    border-top: var(--line);
  }

  .s00-fallback h1 {
    max-width: 16ch;
  }

  .s00-fallback > p,
  .s00-fallback li,
  .s00-fallback aside {
    max-width: 72ch;
  }

  .s00-fallback section {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--line);
  }

  .s00-fallback ul,
  .s00-fallback ol {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .s00-fallback li p {
    margin-bottom: var(--space-2);
    color: var(--ink-700);
  }

  .s00-fallback aside {
    margin-top: var(--space-3);
    padding: var(--space-3);
    border-left: 0.3rem solid var(--limit);
    background: var(--paper-200);
  }

  .s00-fallback__status {
    padding-top: var(--space-5);
    border-top: var(--line);
    color: var(--ink-700);
    font-size: var(--step--1);
  }
</style>
