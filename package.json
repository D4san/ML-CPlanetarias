{
  "name": "ml-ciencias-planetarias-udea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio educativo interactivo y reproducible para ML Ciencias Planetarias.",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:subpath": "cross-env ASTRO_TELEMETRY_DISABLED=1 BASE_PATH=/preview astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:test": "vite preview",
    "check": "npm run format:check && npm run lint && npm run check:astro && npm run validate:content && npm run validate:skills",
    "check:astro": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "cross-env ASTRO_TELEMETRY_DISABLED=1 eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:skills": "node scripts/check-skill-mirrors.mjs",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=functional-chromium --project=a11y --project=reduced-motion",
    "test:e2e:cross-browser": "playwright test --project=functional-firefox --project=functional-webkit",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:visual:linux": "docker compose -f compose.visual.yaml run --rm visual",
    "test:visual:update:linux": "docker compose -f compose.visual.yaml run --rm visual-update",
    "test:all": "npm run test:unit && npm run build && playwright test"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@xyflow/react": "12.11.5",
    "astro": "7.2.2",
    "katex": "0.18.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "1.7.0",
    "globals": "17.11.0",
    "gray-matter": "4.0.3",
    "jsdom": "29.1.1",
    "playwright-core": "1.62.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
